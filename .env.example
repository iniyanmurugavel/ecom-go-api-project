# Copy this file to .env and fill in your values.
# All credentials and config for the project live in .env (do not commit .env).
# Use quotes around values that contain spaces so scripts can source .env.

# ----- Environment -----
# APP_ENV=development | production. In production, JWT_SECRET must be 32+ chars or app exits.
APP_ENV=development

# ----- HTTP server -----
HTTP_ADDR=:8080
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=1m
# REQUEST_TIMEOUT=60s (max time per request; middleware)
# SHUTDOWN_TIMEOUT=10s (graceful shutdown wait)

# ----- JWT -----
# JWT_SECRET: Used to sign and verify JWT tokens. Anyone with this secret can forge valid tokens.
#   - In production: MUST be 32+ random chars. Generate: openssl rand -base64 32
#   - In development: Default below works; app warns if < 32 chars.
# Example random secret (DO NOT use in production; generate your own):
#   JWT_SECRET=K7x9mP2vQ4nR8sT1wY3zA5bC6dE0fG2hI4jL
JWT_SECRET=change-me-in-production-use-long-secret
# JWT_EXPIRY_HOURS=24
# JWT_ISSUER=ecom-api (iss claim; empty = skip validation)
# JWT_AUDIENCE=ecom-api (aud claim; empty = skip validation)

# Rate limit: requests per minute per IP (0 = disabled). Used in production to protect the API.
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# CORS: comma-separated allowed origins for browser requests (empty = CORS disabled).
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
# CORS_ALLOWED_ORIGINS=

# ----- Database (PostgreSQL) -----
# Option A: Full connection string (used by the app and by goose migrations). Use quotes if value has spaces.
# Port 15432: Docker Postgres (avoids Mac Postgres on 5432). CI uses 5432.
GOOSE_DBSTRING="host=localhost port=15432 user=postgres password=postgres dbname=ecom sslmode=disable"

# Option B: Or set these; the app builds the DSN from them (used when GOOSE_DBSTRING is unset)
# DB_HOST=localhost
# DB_PORT=15432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=ecom

# Connection pool tuning (optional). Defaults: MaxConns=25, MinConns=2.
# DB_POOL_MAX_CONNS=25
# DB_POOL_MIN_CONNS=2

# ----- Goose (migrations) -----
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./internal/adapters/postgresql/migrations
