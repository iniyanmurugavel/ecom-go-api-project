# All credentials and config for this project. Used by the app and by scripts (source .env).
# Do not commit .env; copy .env.example to .env and edit.

HTTP_ADDR=:8080

# Database: full DSN (used by app and goose)
GOOSE_DBSTRING="host=localhost port=15432 user=postgres password=postgres dbname=ecom sslmode=disable"

# Or set these instead; app builds DSN from them
# DB_HOST=localhost
# DB_PORT=15432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=ecom

GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./internal/adapters/postgresql/migrations