# Copy this file to .env and fill in your values.
# All credentials and config for the project live in .env (do not commit .env).
# Use quotes around values that contain spaces so scripts can source .env.

# ----- HTTP server -----
HTTP_ADDR=:8080

# ----- Database (PostgreSQL) -----
# Option A: Full connection string (used by the app and by goose migrations). Use quotes if value has spaces.
GOOSE_DBSTRING="host=localhost port=15432 user=postgres password=postgres dbname=ecom sslmode=disable"

# Option B: Or set these; the app builds the DSN from them
# DB_HOST=localhost
# DB_PORT=15432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=ecom

# ----- Goose (migrations) -----
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./internal/adapters/postgresql/migrations
